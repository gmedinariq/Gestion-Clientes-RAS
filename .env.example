# ------------------------------------------------------------------------------------------
# Variables de entorno de docker compose.
#
# Uso: copia este fichero como .env y rellena las contraseñas.
# El fichero .env no se sube al repositorio (.gitignore).
# ------------------------------------------------------------------------------------------

# --- PostgreSQL ---
# Base de datos, usuario y contraseña que se crean la primera vez que arranca el contenedor.
# POSTGRES_PASSWORD es obligatoria: elige cualquier valor para tu instalación local.
# PostgreSQL solo aplica estos valores al inicializar el volumen: si los cambias después,
# hay que recrearlo (docker compose down -v, que borra los datos).
POSTGRES_DB=clientes
POSTGRES_USER=clientes
POSTGRES_PASSWORD=

# Puerto del equipo en el que se publica PostgreSQL (solo en 127.0.0.1). Lo usan los tests
# y permite conectarse con un cliente SQL. Cámbialo si está ocupado.
POSTGRES_PORT=55432

# --- Web ---
# Puerto del equipo en el que se abre la aplicación: http://localhost:8085
WEB_PORT=8085

# --- API ---
# Duración de la sesión de usuario, en horas.
SESSION_HOURS=8

# true solo si la aplicación se sirve por HTTPS (la cookie de sesión se marcará como Secure).
COOKIE_SECURE=false

# --- Usuario de acceso ---
# Se crea (o se actualiza su nombre y contraseña) cada vez que arranca la API.
# La contraseña debe tener al menos 8 caracteres y se guarda con bcrypt.
# Si el email o la contraseña están vacíos, no se crea ningún usuario.
# Cambiar el email crea un usuario nuevo; el anterior no se borra.
DEMO_USER_EMAIL=
DEMO_USER_NAME=
DEMO_USER_PASSWORD=
