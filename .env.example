# ------------------------------------------------------------------------------------------
# Variables de entorno de docker compose.
#
# Uso:  cp .env.example .env   y cambia los valores que quieras.
# El fichero .env es OPCIONAL: si no existe, docker-compose.yml usa los mismos valores que
# aparecen aquí, pensados solo para probar en local. En cualquier entorno compartido o real,
# crea un .env con contraseñas propias. El .env nunca se sube al repositorio (.gitignore).
# ------------------------------------------------------------------------------------------

# --- PostgreSQL ---
# Nombre de la base de datos, usuario y contraseña que se crean la primera vez que arranca el contenedor.
# Ojo: si cambias estos valores después del primer arranque, borra el volumen (docker compose down -v)
# porque PostgreSQL solo los aplica al inicializar la base de datos.
POSTGRES_DB=clientes
POSTGRES_USER=clientes
POSTGRES_PASSWORD=clientes_dev

# Puerto del equipo en el que se publica PostgreSQL (solo en 127.0.0.1). Lo usan los tests
# y permite conectarse con un cliente SQL (DBeaver, psql...). Cámbialo si está ocupado.
POSTGRES_PORT=55432

# --- Web ---
# Puerto del equipo en el que se abre la aplicación: http://localhost:8085
WEB_PORT=8085

# --- API ---
# Duración de la sesión de usuario, en horas.
SESSION_HOURS=8

# true solo si la aplicación se sirve por HTTPS (la cookie de sesión se marcará como Secure).
COOKIE_SECURE=false

# --- Usuario de acceso (por defecto, el de demostración) ---
# Se crea (o se actualiza su contraseña) cada vez que arranca la API. Puedes poner aquí tu propio usuario.
# La contraseña debe tener al menos 8 caracteres y se guarda con bcrypt, nunca en claro.
# Si DEMO_USER_PASSWORD está vacía, no se crea ningún usuario (nunca se usa la contraseña pública).
# Cambiar el email crea un usuario nuevo; el anterior no se borra.
# Los valores de abajo son públicos: solo para desarrollo local.
DEMO_USER_EMAIL=demo@empresa.local
DEMO_USER_NAME=Usuario Demo
DEMO_USER_PASSWORD=Demo1234!
