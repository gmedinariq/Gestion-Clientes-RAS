// Los nombres de tablas y columnas en PostgreSQL van en snake_case (@@map / @map).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoCliente {
  Activo
  Inactivo
}

enum AccionHistorial {
  CREAR
  MODIFICAR
  ELIMINAR
}

model Cliente {
  id          Int           @id @default(autoincrement())
  empresa     String        @db.VarChar(200)
  cif         String        @unique @db.VarChar(20)
  estado      EstadoCliente @default(Activo)
  direccion   String?       @db.VarChar(200)
  cp          String?       @db.VarChar(10)
  ciudad      String?       @db.VarChar(100)
  pais        String?       @db.VarChar(100)
  comercial   String?       @db.VarChar(100)
  fechaAlta   DateTime      @map("fecha_alta") @db.Date
  creadoEn    DateTime      @default(now()) @map("creado_en")
  // Fecha de última modificación: Prisma la actualiza sola en cada UPDATE del cliente
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")
  // Borrado lógico: si tiene fecha, el cliente está "eliminado" (se conservan facturas e histórico)
  eliminadoEn DateTime?     @map("eliminado_en")

  contactos Contacto[]
  facturas  Factura[]
  historial Historial[]

  @@index([estado])
  @@index([pais])
  @@index([comercial])
  @@map("clientes")
}

model Contacto {
  id        Int     @id @default(autoincrement())
  clienteId Int     @map("cliente_id")
  nombre    String  @db.VarChar(150)
  email     String? @db.VarChar(200)
  telefono  String? @db.VarChar(30)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("contactos")
}

model Factura {
  id            Int      @id @default(autoincrement())
  clienteId     Int      @map("cliente_id")
  numero        String   @unique @db.VarChar(30)
  fecha         DateTime @db.Date
  // Decimal(12,2): importes exactos, sin errores de coma flotante
  baseImponible Decimal  @map("base_imponible") @db.Decimal(12, 2)
  ivaPorcentaje Decimal  @map("iva_porcentaje") @db.Decimal(5, 2)
  ivaImporte    Decimal  @map("iva_importe") @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)

  // Restrict: no se puede borrar físicamente un cliente que tenga facturas
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@map("facturas")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(200)
  nombre       String   @db.VarChar(100)
  passwordHash String   @map("password_hash")
  creadoEn     DateTime @default(now()) @map("creado_en")

  sesiones  Sesion[]
  historial Historial[]

  @@map("usuarios")
}

// Sesiones de usuario. En la cookie viaja un token aleatorio; aquí solo guardamos su hash SHA-256,
// así que una copia de la base de datos no permite suplantar sesiones.
model Sesion {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  usuarioId Int      @map("usuario_id")
  expiraEn  DateTime @map("expira_en")
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

// Histórico de modificaciones (requisito D). Una fila por campo modificado.
model Historial {
  id            Int             @id @default(autoincrement())
  clienteId     Int             @map("cliente_id")
  entidad       String          @db.VarChar(20) // "cliente" o "contacto"
  registroId    Int             @map("registro_id") // id del cliente o del contacto modificado
  accion        AccionHistorial
  campo         String?         @db.VarChar(50)
  valorAnterior String?         @map("valor_anterior")
  valorNuevo    String?         @map("valor_nuevo")
  usuarioId     Int             @map("usuario_id")
  fecha         DateTime        @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([clienteId, fecha])
  @@map("historial_cambios")
}

// Resumen de cada ejecución del importador del CSV
model Importacion {
  id               Int      @id @default(autoincrement())
  archivo          String   @db.VarChar(200)
  hashArchivo      String   @map("hash_archivo") @db.VarChar(64)
  fecha            DateTime @default(now())
  filasLeidas      Int      @map("filas_leidas")
  clientesCreados  Int      @map("clientes_creados")
  contactosCreados Int      @map("contactos_creados")
  facturasCreadas  Int      @map("facturas_creadas")
  duplicados       Int
  rechazadas       Int
  incidencias      Json

  @@map("importaciones")
}
